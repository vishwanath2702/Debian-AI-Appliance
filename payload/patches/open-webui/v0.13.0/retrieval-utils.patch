 from langchain_core.retrievers import BaseRetriever
 
 
+
+def daia_bm25_tokens(text: str) -> list[str]:
+    """Normalize lexical tokens, preserving technical identifiers."""
+    import re
+    return re.findall(
+        r"[^\W_]+(?:[-_.][^\W_]+)*",
+        text.casefold(),
+    )
+
+
+
+def daia_bm25_query_tokens(query: str) -> list[str]:
+    """Focus explicit exact-term requests; preserve normal queries."""
+    import re
+
+    patterns = (
+        r"\bexact\s+(?:word|term|identifier)\s+"
+        r"['\"`]?([A-Za-z][A-Za-z0-9_.-]*)",
+        r"\bfind\s+(?:the\s+)?(?:word|term|identifier)\s+"
+        r"['\"`]?([A-Za-z][A-Za-z0-9_.-]*)",
+    )
+    for pattern in patterns:
+        match = re.search(pattern, query, re.IGNORECASE)
+        if match:
+            return daia_bm25_tokens(match.group(1))
+    return daia_bm25_tokens(query)
+
+
+
+def daia_prioritize_exact_matches(docs_with_scores, query, original_text_by_hash):
+    """Preserve literal evidence without changing scores or result limits."""
+    import re
+
+    if not original_text_by_hash:
+        return docs_with_scores
+
+    patterns = (
+        r"\bexact\s+(?:word|term|identifier)\s+",
+        r"\bfind\s+(?:the\s+)?(?:word|term|identifier)\s+",
+    )
+    identifier = None
+
+    for pattern in patterns:
+        match = re.search(
+            pattern + r"['\x22`]?([A-Za-z][A-Za-z0-9_.-]*)",
+            query,
+            re.IGNORECASE,
+        )
+        if match:
+            identifier = match.group(1).casefold()
+            break
+
+    if identifier is None:
+        return docs_with_scores
+
+    def matches_original(item):
+        document, _score = item
+        chunk_hash = document.metadata.get(CHUNK_HASH_KEY)
+        original = original_text_by_hash.get(chunk_hash, "")
+        return identifier in daia_bm25_tokens(original)
+
+    matching = [item for item in docs_with_scores if matches_original(item)]
+    others = [item for item in docs_with_scores if not matches_original(item)]
+
+    # Only quotation/sentence requests need passage-quality ordering.
+    # Preserve the existing similarity ordering for other exact searches.
+    wants_passage = bool(
+        re.search(r"\b(?:quote|quotation|sentence)\b", query, re.IGNORECASE)
+    )
+    if not wants_passage:
+        return matching + others
+
+    def passage_quality(item):
+        document, _score = item
+        original = original_text_by_hash.get(
+            document.metadata.get(CHUNK_HASH_KEY), ""
+        )
+        # Find identifier occurrences with technical-token boundaries.
+        occurrences = list(re.finditer(
+            r"(?<![\w.-])" + re.escape(identifier) + r"(?![\w.-])",
+            original,
+            re.IGNORECASE,
+        ))
+        if not occurrences:
+            return 0
+
+        best = 0
+        for occurrence in occurrences:
+            left = max(0, occurrence.start() - 120)
+            right = min(len(original), occurrence.end() + 120)
+            context = original[left:right]
+            words = re.findall(r"\b[\w]+\b", context)
+            prose_words = [
+                word for word in words
+                if len(word) >= 3 and word.casefold() != identifier
+            ]
+            # Substantive surrounding prose is more useful for a quote
+            # than a bare identifier, link, or index entry.
+            quality = min(len(prose_words), 20)
+            if re.search(r"[.!?]", context):
+                quality += 5
+            best = max(best, quality)
+        return best
+
+    matching = sorted(matching, key=passage_quality, reverse=True)
+    return matching + others
+
