[Unit]
Description=DAIA trusted localhost Open WebUI proxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

Requires=daia-rag-recovery.service
After=daia-rag-recovery.service
AssertPathExists=/var/lib/daia/firstboot-complete
[Service]
Type=simple
ExecStart=/usr/libexec/daia-openwebui-localhost-proxy.py
User=root
Group=root
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
