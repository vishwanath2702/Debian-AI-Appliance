#!/usr/bin/env python3
"""Privileged DAIA Open WebUI container registration entry point.

Registration remains disabled until independent Docker verification
and trusted publication are implemented and tested.
"""

import os
import shutil
import subprocess
import sys

import stat

# Conventional imports are retained only for source-level test loading.
# The installed executable runs as __main__ and uses verified descriptors.
if __name__ != "__main__":
    from pgvector_registration import (
        read_trusted_registration,
        validate_container_id,
    )
    from openwebui_registration import (
        provision_registration_directory,
        register_authorized_container,
    )


def _bind_trusted_dependencies():
    """Bootstrap the installed loader from a verified root-owned descriptor."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    directory_fd = os.open("/", flags)

    try:
        for component in ("usr", "libexec"):
            next_fd = os.open(component, flags, dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd

            metadata = os.fstat(directory_fd)
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid != 0
                or metadata.st_mode & 0o022
            ):
                raise PermissionError("Untrusted loader directory")

        file_fd = os.open(
            "openwebui_trusted_imports.py",
            os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory_fd,
        )

        try:
            before = os.fstat(file_fd)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != 0
                or before.st_mode & 0o022
                or before.st_nlink != 1
                or not 0 < before.st_size <= 1024 * 1024
            ):
                raise PermissionError("Untrusted loader file")

            source = bytearray()
            while len(source) < before.st_size:
                chunk = os.pread(
                    file_fd,
                    min(65536, before.st_size - len(source)),
                    len(source),
                )
                if not chunk:
                    raise OSError("Trusted loader source truncated")
                source.extend(chunk)

            after = os.fstat(file_fd)
            if (
                (before.st_dev, before.st_ino, before.st_size,
                 before.st_mtime_ns, before.st_ctime_ns)
                !=
                (after.st_dev, after.st_ino, after.st_size,
                 after.st_mtime_ns, after.st_ctime_ns)
            ):
                raise PermissionError("Trusted loader changed during reading")
        finally:
            os.close(file_fd)
    finally:
        os.close(directory_fd)

    namespace = {
        "__name__": "_daia_verified_openwebui_loader",
        "__file__": "<verified-openwebui-loader>",
    }
    exec(
        compile(bytes(source), namespace["__file__"], "exec"),
        namespace,
    )

    modules = namespace["load_trusted_runtime_modules"](
        "/opt/daia", expected_uid=0
    )

    pgvector = modules["pgvector_registration"]
    openwebui = modules["openwebui_registration"]

    globals().update({
        "read_trusted_registration": pgvector.read_trusted_registration,
        "validate_container_id": pgvector.validate_container_id,
        "provision_registration_directory":
            openwebui.provision_registration_directory,
        "register_authorized_container":
            openwebui.register_authorized_container,
    })


EXPECTED_IMAGE = (
    "sha256:e29d4d2457b54bb14434bee2666420e822cb0e9389466f02405d69fa7fd8d06c"
)


def inspect_container_identity(container_id: str) -> str:
    """Independently verify the immutable Docker identity and ownership."""
    container_id = validate_container_id(container_id)

    result = subprocess.run(
        [
            "docker",
            "container", "inspect",
            "--format",
            '{{.Id}}{{printf "\t"}}'
            '{{index .Config.Labels "org.daia.component"}}'
            '{{printf "\t"}}'
            '{{index .Config.Labels "org.daia.managed"}}'
            '{{printf "\t"}}{{.Image}}',
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )

    inspection = result.stdout.removesuffix("\n")

    expected = (
        container_id
        + "\topenwebui\ttrue\t"
        + EXPECTED_IMAGE
    )

    if inspection != expected:
        raise PermissionError(
            "Open WebUI immutable identity or ownership mismatch"
        )

    return container_id


def inspect_container_security(container_id: str) -> None:
    """Verify Docker privilege restrictions and isolated network mode."""
    container_id = validate_container_id(container_id)

    security = subprocess.run(
        [
            "docker", "container", "inspect",
            "--format",
            '{{join .HostConfig.SecurityOpt ","}}'
            '{{printf "|"}}{{.HostConfig.Privileged}}',
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    ).stdout.removesuffix("\n")

    if security != "no-new-privileges:true|false":
        raise PermissionError(
            "Open WebUI security configuration mismatch"
        )

    network_mode = subprocess.run(
        [
            "docker", "container", "inspect",
            "--format", "{{.HostConfig.NetworkMode}}",
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    ).stdout.removesuffix("\n")

    if network_mode != "daia-rag-internal":
        raise PermissionError(
            "Open WebUI network isolation mismatch"
        )


def inspect_container_mounts(container_id: str) -> None:
    """Require exactly the three DAIA Open WebUI mounts."""
    container_id = validate_container_id(container_id)

    result = subprocess.run(
        [
            "docker", "container", "inspect",
            "--format",
            '{{range .Mounts}}'
            '{{printf "%s|%s|%s|%s|%t\n" '
            '.Type .Name .Source .Destination .RW}}'
            '{{end}}',
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )

    expected_secret = (
        "bind||/var/lib/daia/pgvector/openwebui-password"
        "|/run/secrets/daia-openwebui-pgvector-password|false"
    )
    expected_entrypoint = (
        "bind||/usr/libexec/daia-openwebui-rag-entrypoint.py"
        "|/usr/local/bin/daia-openwebui-rag-entrypoint.py|false"
    )

    mounts = result.stdout.splitlines()

    if len(mounts) != 3 or len(set(mounts)) != 3:
        raise PermissionError("Invalid Open WebUI mount count")

    if expected_secret not in mounts:
        raise PermissionError("Open WebUI credential mount mismatch")

    if expected_entrypoint not in mounts:
        raise PermissionError("Open WebUI entrypoint mount mismatch")

    remaining = [
        mount for mount in mounts
        if mount not in (expected_secret, expected_entrypoint)
    ]

    if len(remaining) != 1:
        raise PermissionError("Invalid Open WebUI data mount")

    fields = remaining[0].split("|")

    if len(fields) != 5:
        raise PermissionError("Malformed Open WebUI data mount")

    mount_type, name, source_path, destination, writable = fields

    if (
        mount_type != "volume"
        or name != "open-webui"
        or destination != "/app/backend/data"
        or writable != "true"
        or not source_path.startswith("/")
        or source_path == "/"
        or "|" in source_path
        or "\\n" in source_path
        or "\\r" in source_path
    ):
        raise PermissionError("Open WebUI data mount mismatch")

    volume_mountpoint = subprocess.run(
        [
            "docker", "volume", "inspect",
            "--format", "{{.Mountpoint}}",
            "open-webui",
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    ).stdout.removesuffix("\n")

    if volume_mountpoint != source_path:
        raise PermissionError(
            "Open WebUI volume mountpoint mismatch"
        )


def inspect_volume_ownership() -> None:
    """Independently verify ownership of the Open WebUI data volume."""
    labels = subprocess.run(
        [
            "docker", "volume", "inspect",
            "--format",
            '{{index .Labels "org.daia.component"}}'
            '{{printf "\t"}}'
            '{{index .Labels "org.daia.managed"}}',
            "open-webui",
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    ).stdout.removesuffix("\n")

    if labels != "openwebui\ttrue":
        raise PermissionError(
            "Open WebUI persistent volume ownership mismatch"
        )




def inspect_container_stopped(container_id: str) -> None:
    """Require a created or exited, non-running Open WebUI container."""
    container_id = validate_container_id(container_id)

    result = subprocess.run(
        [
            "docker", "container", "inspect",
            "--format",
            '{{.State.Running}}{{printf "|"}}'
            '{{.State.Paused}}{{printf "|"}}'
            '{{.State.Restarting}}{{printf "|"}}'
            '{{.State.Status}}',
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )

    state = result.stdout.removesuffix("\n")

    if state not in (
        "false|false|false|created",
        "false|false|false|exited",
    ):
        raise PermissionError(
            "Open WebUI container is not safely stopped"
        )

def read_registered_postgresql_id() -> str:
    """Retrieve PostgreSQL identity from DAIA's trusted registration."""
    container_id = read_trusted_registration(
        "/var/lib/daia/pgvector"
    )
    return validate_container_id(container_id)


def verify_registration_network(postgresql_container_id: str) -> None:
    """Require the DAIA private network to have authorized membership."""
    postgresql_container_id = validate_container_id(
        postgresql_container_id
    )

    subprocess.run(
        [
            "/usr/libexec/daia-rag-verify-network",
            "registration",
            postgresql_container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )


def revalidate_container_before_registration(
    container_id: str,
) -> str:
    """Recheck immutable identity and stopped state before registration."""
    container_id = validate_container_id(container_id)

    verified_id = inspect_container_identity(container_id)

    if verified_id != container_id:
        raise PermissionError(
            "Open WebUI identity changed before registration"
        )

    inspect_container_stopped(verified_id)

    return verified_id



def verify_container_for_registration(container_id: str, tika_id=None) -> str:
    """Authorize registration through independent, fail-closed checks."""
    container_id = validate_container_id(container_id)

    verified_id = inspect_container_identity(container_id)
    if verified_id != container_id:
        raise PermissionError(
            "Open WebUI identity changed during initial inspection"
        )

    inspect_container_stopped(verified_id)
    inspect_container_security(verified_id)
    inspect_container_mounts(verified_id)
    inspect_volume_ownership()

    postgresql_id = read_registered_postgresql_id()
    if tika_id is None:
        verify_registration_network(postgresql_id)
    else:
        tika_id = validate_container_id(tika_id)
        if tika_id in (postgresql_id, container_id):
            raise PermissionError("Duplicate RAG container identity")

        # This verifier delegates to the PostgreSQL authorizer,
        # which independently proves Tika's trusted registration,
        # immutable identity and exact network membership.
        subprocess.run(
            [
                "/usr/libexec/daia-rag-verify-network",
                "registration", postgresql_id, tika_id,
            ],
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        )

    final_id = revalidate_container_before_registration(verified_id)
    if final_id != verified_id:
        raise PermissionError(
            "Open WebUI identity changed during final verification"
        )

    return final_id



def authorize_registered_container_for_start(container_id: str, tika_id=None) -> str:
    """Read-only startup authorization for one registered, stopped container."""
    if os.geteuid() != 0:
        raise PermissionError("Open WebUI startup authorization requires root")

    container_id = validate_container_id(container_id)

    # A Docker name or ownership label cannot substitute for registration.
    registered_id = read_trusted_registration("/var/lib/daia/openwebui")
    if registered_id != container_id:
        raise PermissionError("Open WebUI registration identity mismatch")

    # Reuse the independent immutable-image, stopped-state, security,
    # mount, volume, and PostgreSQL-network registration checks.
    if tika_id is None:
        verified_id = verify_container_for_registration(container_id)
    else:
        tika_id = validate_container_id(tika_id)
        verified_id = verify_container_for_registration(
            container_id, tika_id=tika_id
        )
    if verified_id != container_id:
        raise PermissionError("Open WebUI inspection identity mismatch")

    # The RAG authorizer independently verifies PostgreSQL identity,
    # readiness, stored SCRAM credential, and restricted role privileges.
    role_command = ["/usr/libexec/daia-openwebui-rag-authorize"]
    if tika_id is not None:
        role_command.extend(["--tika-id", tika_id])

    try:
        role_result = subprocess.run(
            role_command,
            capture_output=True,
            text=True,
            check=False,
            timeout=90,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PermissionError(
            "Open WebUI startup RAG authorization unavailable"
        ) from error

    if role_result.returncode != 0 or role_result.stdout != "":
        raise PermissionError("Open WebUI startup RAG authorization failed")

    # Recheck both Docker state and trusted registration after the
    # potentially long-running RAG verification.
    final_id = revalidate_container_before_registration(container_id)
    if final_id != container_id:
        raise PermissionError("Open WebUI identity changed before startup")

    if read_trusted_registration("/var/lib/daia/openwebui") != container_id:
        raise PermissionError("Open WebUI registration changed before startup")

    if tika_id is not None:
        # Recheck trusted Tika membership after the database-role proof.
        if verify_container_for_registration(
            container_id, tika_id=tika_id
        ) != container_id:
            raise PermissionError("Combined RAG identity changed before startup")

    return container_id



def verify_registered_container_identity(container_id: str) -> str:
    """Read-only identity proof, independent of running state."""
    if os.geteuid() != 0:
        raise PermissionError("Open WebUI identity verification requires root")

    container_id = validate_container_id(container_id)
    registered_id = read_trusted_registration("/var/lib/daia/openwebui")

    if registered_id != container_id:
        raise PermissionError("Open WebUI registration identity mismatch")

    if inspect_container_identity(container_id) != container_id:
        raise PermissionError("Open WebUI Docker identity mismatch")

    inspect_container_security(container_id)
    inspect_container_mounts(container_id)
    inspect_volume_ownership()

    if read_trusted_registration("/var/lib/daia/openwebui") != container_id:
        raise PermissionError("Open WebUI registration changed")

    return container_id


def inspect_container_running(container_id: str) -> None:
    """Require an active, unpaused, non-restarting Docker container."""
    container_id = validate_container_id(container_id)

    result = subprocess.run(
        [
            "docker", "container", "inspect",
            "--format",
            '{{.State.Running}}{{printf "|"}}'
            '{{.State.Paused}}{{printf "|"}}'
            '{{.State.Restarting}}{{printf "|"}}'
            '{{.State.Status}}',
            container_id,
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )

    if result.stdout != "true|false|false|running\n":
        raise PermissionError("Open WebUI is not safely running")


def verify_openwebui_runtime_network(
    postgresql_id: str, openwebui_id: str, tika_id=None
) -> None:
    """Require exactly the authorized PostgreSQL and WebUI attachments."""
    postgresql_id = validate_container_id(postgresql_id)
    openwebui_id = validate_container_id(openwebui_id)

    if postgresql_id == openwebui_id:
        raise PermissionError("Duplicate RAG container identity")

    network_command = [
        "/usr/libexec/daia-rag-verify-network",
        "runtime",
        postgresql_id,
        openwebui_id,
    ]

    if tika_id is not None:
        tika_id = validate_container_id(tika_id)
        if tika_id in (postgresql_id, openwebui_id):
            raise PermissionError("Duplicate RAG container identity")

        # Independently prove Tika's immutable trusted registration.
        identity_result = subprocess.run(
            [
                "/usr/libexec/daia-tika-register-container",
                "--verify-identity",
                tika_id,
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=20,
        )
        if (
            identity_result.returncode != 0
            or identity_result.stdout != tika_id + "\n"
        ):
            raise PermissionError("Tika trusted identity verification failed")

        network_command.append(tika_id)

    subprocess.run(
        network_command,
        capture_output=True,
        text=True,
        check=True,
        timeout=20,
    )


def verify_running_rag_role(container_id: str, tika_id=None) -> None:
    """Reauthorize database access without provisioning or mutation."""
    command = [
        "/usr/libexec/daia-openwebui-rag-authorize",
        "--webui-id",
        validate_container_id(container_id),
    ]
    if tika_id is not None:
        command.extend([
            "--tika-id", validate_container_id(tika_id)
        ])

    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
            timeout=90,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PermissionError(
            "Open WebUI runtime RAG authorization unavailable"
        ) from error

    if result.returncode != 0 or result.stdout != "":
        raise PermissionError(
            "Open WebUI runtime RAG authorization failed"
        )


def verify_registered_running_container(container_id: str, tika_id=None) -> str:
    """Read-only recovery proof for an already-running Open WebUI."""
    if tika_id is not None:
        tika_id = validate_container_id(tika_id)
        if tika_id == container_id:
            raise PermissionError("Duplicate RAG container identity")

    container_id = verify_registered_container_identity(container_id)
    inspect_container_running(container_id)

    postgresql_id = read_registered_postgresql_id()
    if tika_id is None:
        verify_openwebui_runtime_network(postgresql_id, container_id)
        verify_running_rag_role(container_id)
    else:
        verify_openwebui_runtime_network(
            postgresql_id, container_id, tika_id=tika_id
        )
        verify_running_rag_role(container_id, tika_id=tika_id)

    # Repeat identity, state and network checks after database proof.
    if verify_registered_container_identity(container_id) != container_id:
        raise PermissionError("Open WebUI runtime identity changed")

    inspect_container_running(container_id)

    if read_registered_postgresql_id() != postgresql_id:
        raise PermissionError("PostgreSQL registration changed")

    if tika_id is None:
        verify_openwebui_runtime_network(postgresql_id, container_id)
    else:
        verify_openwebui_runtime_network(
            postgresql_id, container_id, tika_id=tika_id
        )
    return container_id


def main() -> int:
    if os.geteuid() != 0:
        raise PermissionError("Open WebUI registration requires root")

    if (
        len(sys.argv) == 5
        and sys.argv[1] == "--verify-running"
        and sys.argv[3] == "--tika-id"
    ):
        container_id = validate_container_id(sys.argv[2])
        tika_id = validate_container_id(sys.argv[4])

        if container_id == tika_id:
            raise PermissionError("Duplicate RAG container identity")

        if shutil.which("docker") is None:
            raise RuntimeError("Docker is unavailable")

        verified_id = verify_registered_running_container(
            container_id, tika_id=tika_id
        )
        if verified_id != container_id:
            raise PermissionError("Open WebUI runtime identity mismatch")

        print(verified_id)
        return 0

    if len(sys.argv) == 3 and sys.argv[1] in (
        "--verify-running", "--verify-identity"
    ):
        container_id = validate_container_id(sys.argv[2])

        if shutil.which("docker") is None:
            raise RuntimeError("Docker is unavailable")

        if sys.argv[1] == "--verify-running":
            verified_id = verify_registered_running_container(container_id)
        else:
            verified_id = verify_registered_container_identity(container_id)

        if verified_id != container_id:
            raise PermissionError("Open WebUI verification identity mismatch")

        print(verified_id)
        return 0

    if (
        (len(sys.argv) == 3 and sys.argv[1] == "--authorize-start")
        or (
            len(sys.argv) == 5
            and sys.argv[1] == "--authorize-start"
            and sys.argv[3] == "--tika-id"
        )
    ):
        container_id = validate_container_id(sys.argv[2])
        tika_id = (
            validate_container_id(sys.argv[4])
            if len(sys.argv) == 5
            else None
        )

        if shutil.which("docker") is None:
            raise RuntimeError("Docker is unavailable")

        if tika_id is None:
            verified_id = authorize_registered_container_for_start(container_id)
        else:
            verified_id = authorize_registered_container_for_start(
                container_id, tika_id=tika_id
            )
        if verified_id != container_id:
            raise PermissionError("Open WebUI startup identity mismatch")

        print(verified_id)
        return 0

    if len(sys.argv) == 2:
        tika_id = None
        container_id = validate_container_id(sys.argv[1])
    elif len(sys.argv) == 4 and sys.argv[1] == "--tika-id":
        tika_id = validate_container_id(sys.argv[2])
        container_id = validate_container_id(sys.argv[3])
    else:
        raise ValueError("Invalid Open WebUI registration arguments")

    if shutil.which("docker") is None:
        raise RuntimeError("Docker is unavailable")

    if tika_id is None:
        verified_id = verify_container_for_registration(container_id)
    else:
        verified_id = verify_container_for_registration(
            container_id, tika_id=tika_id
        )

    if verified_id != container_id:
        raise PermissionError(
            "Open WebUI verified identity does not match requested identity"
        )

    provision_registration_directory()

    register_authorized_container(
        verified_id,
        EXPECTED_IMAGE,
        EXPECTED_IMAGE,
        {
            "org.daia.component": "openwebui",
            "org.daia.managed": "true",
        },
        "daia-rag-internal",
        ["no-new-privileges:true"],
        False,
    )

    return 0


if __name__ == "__main__":
    try:
        if os.geteuid() != 0:
            raise PermissionError("Open WebUI registration requires root")
        _bind_trusted_dependencies()
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as error:
        print(
            f"DAIA Open WebUI registration refused: {error}",
            file=sys.stderr,
        )
        raise SystemExit(1)
