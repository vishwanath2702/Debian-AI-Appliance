#!/usr/bin/env python3
"""Fail-closed, read-only SearXNG container verification."""

import json
import os
import re
import subprocess
import sys

IMAGE = "sha256:be131d45cb5daf22a1f47c530b6d11063c76e53bf0efa99d047b07e4b3d4274d"
NAME = "daia-searxng"
INTERNAL = "daia-rag-internal"
EGRESS = "daia-searxng-egress"


def valid_id(value):
    return (
        isinstance(value, str)
        and re.fullmatch("[0-9a-f]{64}", value) is not None
    )


def require(condition, message):
    if not condition:
        raise PermissionError(message)


def inspect(*args):
    result = subprocess.run(
        ["docker", *args],
        capture_output=True,
        text=True,
        check=True,
        timeout=20,
    )
    return json.loads(result.stdout)


def network(name, internal, component):
    result = inspect("network", "inspect", name)

    require(
        isinstance(result, list) and len(result) == 1,
        "Malformed network inspection",
    )

    value = result[0]

    require(value.get("Name") == name, "Network name mismatch")
    require(value.get("Driver") == "bridge", "Network driver mismatch")
    require(value.get("Internal") is internal,
            "Network isolation mismatch")

    labels = value.get("Labels") or {}

    require(
        labels.get("org.daia.component") == component,
        "Network ownership mismatch",
    )
    require(
        labels.get("org.daia.managed") == "true",
        "Unmanaged network",
    )
    require(valid_id(value.get("Id")),
            "Invalid network identity")

    return value


def verify(expected_id):
    require(os.geteuid() == 0, "Root required")
    require(valid_id(expected_id), "Invalid container identity")

    result = inspect("container", "inspect", NAME)

    require(
        isinstance(result, list) and len(result) == 1,
        "Malformed container inspection",
    )

    container = result[0]

    require(container.get("Id") == expected_id,
            "Container identity mismatch")
    require(container.get("Name") == "/" + NAME,
            "Container name mismatch")
    require(container.get("Image") == IMAGE,
            "Image identity mismatch")

    config = container.get("Config") or {}
    labels = config.get("Labels") or {}

    require(
        labels.get("org.daia.component") == "searxng",
        "Component ownership mismatch",
    )
    require(
        labels.get("org.daia.managed") == "true",
        "Unmanaged container",
    )

    host = container.get("HostConfig") or {}

    require(
        host.get("Privileged") is False,
        "Privileged container forbidden",
    )
    require(
        host.get("SecurityOpt") == ["no-new-privileges:true"],
        "Security options mismatch",
    )
    require(
        host.get("NetworkMode") == INTERNAL,
        "Primary network mismatch",
    )
    require(
        not host.get("PortBindings"),
        "Published ports forbidden",
    )
    require(not host.get("Binds"), "Host binds forbidden")
    require(not host.get("Mounts"), "Host mounts forbidden")
    require(
        not container.get("Mounts"),
        "Unexpected container mounts",
    )

    attachments = (
        (container.get("NetworkSettings") or {}).get("Networks")
    )

    require(
        isinstance(attachments, dict)
        and set(attachments) == {INTERNAL, EGRESS},
        "Unexpected network attachments",
    )

    internal = network(INTERNAL, True, "rag")
    egress = network(EGRESS, False, "searxng")

    state = container.get("State") or {}
    running = state.get("Running")
    paused = state.get("Paused")
    restarting = state.get("Restarting")
    status = state.get("Status")

    require(
        paused is False and restarting is False,
        "SearXNG is paused or restarting",
    )

    if running is True:
        require(status == "running", "Invalid running state")
    else:
        require(
            running is False and status in ("created", "exited"),
            "Invalid stopped state",
        )

    for name, value in (
        (INTERNAL, internal),
        (EGRESS, egress),
    ):
        attachment = attachments[name]

        require(
            isinstance(attachment, dict)
            and attachment.get("NetworkID") == value["Id"],
            "Network identity mismatch",
        )

        members = value.get("Containers")
        require(
            isinstance(members, dict),
            "Malformed network membership",
        )

        # Docker can omit stopped containers from active membership.
        # Never permit a different identity on either network.
        require(
            set(members).issubset({expected_id})
            if name == EGRESS
            else True,
            "Unauthorized egress member",
        )

        if running is True:
            require(
                expected_id in members,
                "Missing running SearXNG network attachment",
            )

    require(
        set(egress["Containers"]).issubset({expected_id}),
        "Unauthorized egress member",
    )

    again = inspect("container", "inspect", expected_id)

    require(
        isinstance(again, list) and len(again) == 1,
        "Malformed immutable identity inspection",
    )
    require(
        again[0].get("Id") == expected_id
        and again[0].get("Image") == IMAGE,
        "Container identity changed",
    )

    return expected_id


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise PermissionError(
                "Expected immutable container ID"
            )
        print(verify(sys.argv[1]))
    except (
        PermissionError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
        OSError,
    ) as exc:
        print(
            "SearXNG verification failed: " + str(exc),
            file=sys.stderr,
        )
        sys.exit(1)
